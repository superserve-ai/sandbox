#!/bin/sh
# Host-resident capability floors for superserve-vmd, invoked from its own
# systemd drop-in at every service start. It lives in a file and a drop-in of
# its own, which deploy scripts from before it never install or overwrite:
# rolling back to such a revision replaces the other guard with that
# revision's copy, but leaves this one exactly as it is.
#
# Each floor is one fact about this host that only a vmd carrying the matching
# capability handles safely, witnessed by an evidence file that whatever
# creates the fact writes first. Nothing here walks the snapshot trees: a host
# holds far too many images for a walk at every start, so the witness has to
# be there before the fact is.
#
# wake-protocol-1: an image whose workload was frozen for its snapshot owes a
# wake that only a vmd speaking the protocol can give; any other vmd restores
# it and leaves it stopped. The template builder writes the evidence before it
# publishes a frozen template, the daemon before it freezes or restores one,
# and any import of one from elsewhere.
#
# staged-intent-1: a capture of a running sandbox journals an intent saying
# the sandbox's own images were not rewritten. A vmd without the capability
# recovers that intent as an interrupted rewrite and strips the manifest those
# images still need. The daemon writes the evidence before the first such
# intent.
set -u
LC_ALL=C
export LC_ALL
BIN="${1:-/usr/local/bin/vmd}"

# require EVIDENCE CAPABILITY WHAT. One lookup. Only a lookup that says the
# evidence does not exist admits any vmd. A lookup that fails any other way —
# an ancestor that cannot be traversed, a symlink loop — is not absence, and
# is treated as presence. Evidence present, or unknowable: only a binary
# carrying the capability may start, checked in one pass over the binary,
# bounded by its size; a grep that cannot run refuses.
require() {
    lookup=$(stat -L "$1" 2>&1 >/dev/null)
    if [ $? -ne 0 ]; then
        case "$lookup" in
            *"No such file or directory"*) return 0 ;;
            *) echo "vmd-wake-floor-guard: cannot look up $1 (${lookup}); only a vmd with $2 may start" >&2 ;;
        esac
    fi
    if grep -qa "$2" "$BIN" 2>/dev/null; then
        return 0
    fi
    echo "vmd-wake-floor-guard: REFUSING to start a vmd without $2: $3 ($1)" >&2
    echo "vmd-wake-floor-guard: deploy a capable build; the floor comes down only once nothing on this host depends on it" >&2
    return 1
}

require /var/lib/sandbox/wake-protocol-evidence wake-protocol-1 "this host holds images that owe a wake" || exit 1
require /var/lib/sandbox/staged-intent-evidence staged-intent-1 "this host has journalled staged capture intents" || exit 1
exit 0
