#!/bin/sh
# Host-resident rollback guard for superserve-vmd, invoked from a systemd
# drop-in at every service start. It exists OUTSIDE the versioned deploy
# script on purpose: deploying an older revision restores that revision's
# deploy script, which predates the in-script drain gate — but never removes
# this file or its drop-in. Without it, a rollback can install a vmd that
# does not understand cgroup supervision over live or paused direct-spawn
# VMs; that binary reads their records, finds no systemd unit, concludes
# they are dead, and kills them.
#
# A binary carrying the capability marker is allowed unconditionally — it
# manages its own state, and the deploy script's gate covers capable
# downgrades. Only an incapable binary on a host with direct-spawn evidence
# is blocked.
set -u
BIN="${1:-/usr/local/bin/vmd}"

# The capable vmd records its RESOLVED state path at a fixed location at
# startup, and both arming direct spawn AND managing existing cgroup records
# require that write (it refuses to start otherwise) — so "cgroup records
# exist but no current breadcrumb" is unrepresentable. Reading it means this guard
# never parses env files (systemd's EnvironmentFile grammar — quotes,
# escapes, continuations — belongs to systemd) and cannot disagree with the
# daemon about where the store lives.
BREADCRUMB=/var/lib/sandbox/vmd-state-path

if grep -qa cgroup-supervision "$BIN" 2>/dev/null; then
    exit 0
fi

# Fail closed on inspection failure: a lookup error is not evidence of
# absence, and a survivor from the crash window between spawn and persist
# has a cgroup but no record — if the scope cannot be read, the byte scan
# below alone cannot clear the host.
evidence=""
if ! VMS_CG=$(systemctl show -p ControlGroup --value superserve-vms.service 2>/dev/null); then
    echo "vmd-rollback-guard: cannot inspect the delegated VM scope (systemctl failed); refusing to start a vmd without cgroup supervision" >&2
    exit 1
fi
if [ -n "$VMS_CG" ] && [ -d "/sys/fs/cgroup${VMS_CG}" ]; then
    if ! children=$(find "/sys/fs/cgroup${VMS_CG}" -mindepth 1 -maxdepth 1 -type d ! -name keeper 2>/dev/null); then
        echo "vmd-rollback-guard: cannot read the delegated VM scope; refusing to start a vmd without cgroup supervision" >&2
        exit 1
    fi
    child=$(printf '%s\n' "$children" | sed -n 1p)
    [ -n "$child" ] && evidence="live VM cgroup ${child}"
fi
if [ -z "$evidence" ]; then
    # A missing breadcrumb means no capable vmd ever armed here, so only the
    # default location could hold records; a present-but-unreadable one must
    # block — with every direct-spawn VM paused it is the only route to the
    # store.
    STATE=/var/lib/sandbox/vmd.db
    if [ -e "$BREADCRUMB" ]; then
        if ! STATE=$(head -n 1 "$BREADCRUMB" 2>/dev/null) || [ -z "$STATE" ]; then
            echo "vmd-rollback-guard: cannot read the recorded state path; refusing to start a vmd without cgroup supervision" >&2
            exit 1
        fi
    fi
    # A byte-level scan, so a stale copy of a deleted record on a free page can
    # block a legitimately drained rollback — the safe direction. The error
    # text carries the remediation. With every direct-spawn VM paused there
    # are no cgroup directories, so this file is the ONLY evidence — a scan
    # error must block, not read as a clean miss. A missing file is a clean
    # miss: a host that never ran vmd has no store and no records.
    if [ -e "$STATE" ]; then
        # Key presence, not the exact "cgroup" value: unit mode omits the
        # field entirely, so ANY supervision key is a record an old binary
        # cannot manage — including modes newer than this guard.
        grep -qa '"supervision":"' "$STATE" 2>/dev/null
        rc=$?
        if [ "$rc" -eq 0 ]; then
            evidence="non-unit supervision records in ${STATE}"
        elif [ "$rc" -ne 1 ]; then
            echo "vmd-rollback-guard: cannot scan ${STATE}; refusing to start a vmd without cgroup supervision" >&2
            exit 1
        fi
    fi
fi

if [ -n "$evidence" ]; then
    echo "vmd-rollback-guard: REFUSING to start a vmd without cgroup supervision: ${evidence}" >&2
    echo "vmd-rollback-guard: deploy a cgroup-aware build, or drain every direct-spawn VM (and compact or move the state file if only stale records remain) before rolling back" >&2
    exit 1
fi
exit 0
