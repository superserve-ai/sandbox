[Unit]
Description=Superserve VM Daemon
After=network-online.target superserve-vmd.socket superserve-vms.service
Wants=network-online.target
Requires=superserve-vmd.socket
# Pull in the delegated-subtree keeper on EVERY vmd start, including a
# socket-activated one. Before= on the keeper only orders units already queued;
# without this Wants= a socket connection under sockets.target can start vmd
# before multi-user.target starts the keeper, and ArmDirectSpawn would find no
# delegated scope (permanent unit-path fallback, or fatal if cgroup VMs exist).
# Wants= not Requires=: a genuinely-failed keeper should let vmd degrade to the
# unit path, not refuse to start.
Wants=superserve-vms.service

[Service]
Type=simple
ExecStart=/usr/local/bin/vmd

# Reload the egress blocklist config (domains + CIDRs) without bouncing the
# daemon. vmd handles SIGHUP; blocked-port changes still need a restart.
ExecReload=/bin/kill -HUP $MAINPID

# DO NOT add ExecStartPre commands that kill Firecracker processes or
# remove network namespaces. VMs must survive VMD restarts — firecracker@
# units (unit mode) run under sandboxes.slice, and direct-spawn VMs run in the
# delegated superserve-vms.service, both outside this unit's cgroup.

# process: signal the main process only, never the cgroup. Retained for
# defense-in-depth and back-compat through the direct-spawn migration —
# direct-spawn VMs no longer live in this unit's cgroup (they run under
# superserve-vms.service), so VM survival no longer depends on it. vmd
# verifies KillMode=process on superserve-vms.service, not this unit.
KillMode=process
# Delegate the cgroup subtree to vmd. Retained through the migration; the
# direct-spawn VM subtree now lives under the delegated superserve-vms.service,
# not here. No effect in unit mode (vmd creates no sub-cgroups).
Delegate=yes
Restart=always
RestartSec=2

# Environment
EnvironmentFile=/etc/sandbox/vmd.env

LimitNOFILE=65536

# Weight vmd below the default (100) for CPU and IO so its background
# work — backup hashing and upload streaming, staging copies, sweeps —
# yields to live VMs under contention. Weights are proportional-share,
# not caps: an idle host gives vmd full throughput, which is exactly the
# shape backup drain wants (full speed when quiet, back off when tenant
# VMs need the cores or the disk). Direct-spawn VMs run under the
# delegated superserve-vms.service and firecracker@ units under
# sandboxes.slice, both siblings of this unit at default weight, so
# these values bias every peer contention in the VMs' favor. The
# tradeoff is that vmd's own RPC paths (pause, resume) are deprioritized
# too; the pause-hook duration histogram is the guard metric, and the
# escape hatch if it regresses is moving upload work into a sub-cgroup,
# not removing the weights.
CPUWeight=25
IOWeight=25

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vmd

[Install]
WantedBy=multi-user.target
