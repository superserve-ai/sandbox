[Unit]
Description=Superserve VM Daemon
After=network-online.target superserve-vmd.socket
Wants=network-online.target
Requires=superserve-vmd.socket

[Service]
Type=simple
ExecStart=/usr/local/bin/vmd

# Reload the egress blocklist config (domains + CIDRs) without bouncing the
# daemon. vmd handles SIGHUP; blocked-port changes still need a restart.
ExecReload=/bin/kill -HUP $MAINPID

# DO NOT add ExecStartPre commands that kill Firecracker processes or
# remove network namespaces. VMs must survive VMD restarts — whether run as
# firecracker@ units (unit mode) or in vmd's delegated cgroup subtree
# (direct-spawn mode).

# process: signal the main process only, never the cgroup. Load-bearing for
# direct-spawn mode — VMs run in vmd's delegated subtree there, so killing
# the cgroup on stop would take every VM with it. Harmless in unit mode
# (firecracker@ units aren't in this cgroup). vmd verifies this at startup
# before arming direct spawn and refuses to arm if it is anything else.
KillMode=process
# Delegate the cgroup subtree to vmd: systemd creates the service cgroup and
# then leaves everything below it alone, so vmd can own per-VM sub-cgroups
# for direct spawn. No effect in unit mode (vmd creates no sub-cgroups).
Delegate=yes
Restart=always
RestartSec=2

# Environment
EnvironmentFile=/etc/sandbox/vmd.env

LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vmd

[Install]
WantedBy=multi-user.target
