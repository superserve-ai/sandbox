# Guest features sandboxes rely on, layered over Firecracker's 6.1 CI configs.
#
# Published as hostprep/vmlinux-6.1.158 (monolithic, no modules shipped) with
# its resolved config beside it as vmlinux-6.1.158.config.
# KERNEL_PATH in /etc/sandbox/vmd.env names the file vmd boots; only cold boots
# (template builds, revives, backup restores) read it, while snapshot restores
# keep the kernel captured in the snapshot.
# Source: amazonlinux/linux tag microvm-kernel-6.1.158-15.288.amzn2023, commit
# c2b7f640ec01cb093c6ba9e08b7ebcb400741bb4. Base configs, in order:
# microvm-kernel-ci-x86_64-6.1.config, ci.config, pcie.config,
# virtio-pmem.config, virtio-mem.config and vmclock.config from
# resources/guest_configs/ in superserve-ai/firecracker at de258de2535f, then
# this file. Toolchain: Ubuntu 24.04, gcc 13.3. Published artifact sha256:
# 9868c342e90b1ad94d12416a52518689ed618082b5db55686119ddf266f78393.
#
# make olddefconfig silently drops options whose dependencies are unmet; check
# every option here survived. Any change must keep IP_PNP, PTP_1588_CLOCK_KVM,
# CGROUP_FREEZER and the other cgroup v1 controllers the guest init mounts,
# SERIO_I8042 (reboot=k), DEVTMPFS, SWAP and FUSE_FS.
# FUSE-based filesystem mounts.
CONFIG_FUSE_FS=y
# VPN clients and rootless container networking need /dev/net/tun.
CONFIG_TUN=y
# seccomp filters (browsers, container runtimes) run JIT-compiled; the JIT
# requires module support. No modules are shipped.
CONFIG_MODULES=y
CONFIG_BPF_JIT=y
# Every exec moves its process into the workload freezer cgroup. Since 6.0 each
# such move waits out an RCU grace period unless this is set.
CONFIG_CGROUP_FAVOR_DYNMODS=y
# Docker with either iptables backend.
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_RAW=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_IP_VS=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_NF_CT_NETLINK=y
