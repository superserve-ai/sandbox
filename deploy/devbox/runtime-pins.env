# Host runtime a devbox installs unless devbox.env overrides a value. These
# track what the staging cell runs, so a devbox exercises the same VMM,
# guest kernel and base image as staging; bump them when staging moves.
#
# Firecracker: the release the staging cell last installed through the Deploy
# Firecracker workflow, and the digest that run verified.
DEVBOX_FIRECRACKER_VERSION=v1.15.6
DEVBOX_FIRECRACKER_SHA256=2ea3e205c98773fa0616324974f571a329c1fa193393cb40b6d875d8a427f0af

# Guest kernel and base rootfs: the staging host's verified files (see
# Host and control-plane identity preparation runbook), fetched from the shared read-only devbox
# artifact bucket under hostprep/ and checked against these SHA-256 digests. The rootfs digest is
# the staging copy as recorded; every VMD install re-injects the boxd it
# builds, so the installed copy diverges from it by design.
DEVBOX_KERNEL_OBJECT=vmlinux-4.14-fuse
DEVBOX_KERNEL_DIGEST=3be77273fc267d2d2c239dc081cb3955f320dd0d3790de2b02690cb7f1af6761
DEVBOX_ROOTFS_OBJECT=base.ext4
DEVBOX_ROOTFS_DIGEST=7494f2288113b40f881575dfa8dfa6e50c4c78114a9d144af36f67fedf720ca0

# Go toolchain the box builds host binaries with. go.mod's own version is
# fetched by this toolchain when a revision asks for a newer one.
DEVBOX_GO_VERSION=go1.25.0
DEVBOX_GO_SHA256=2852af0cb20a13139b3448992e69b868e50ed0f8a1e5940ee1de9e19a123b613
