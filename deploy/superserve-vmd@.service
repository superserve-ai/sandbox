[Unit]
Description=Superserve vmd generation %i
# Ordering + a soft want only — NOT Requires. A generation must not be torn down
# when the gateway restarts (the gateway is a separately deployable front); its
# routing/controller state recovers on its own.
After=network-online.target superserve-vmd-gateway.service superserve-vms.service
Wants=network-online.target superserve-vms.service superserve-vmd-gateway.service

# A vmd generation. It serves control-plane gRPC and the resolver on private
# unix sockets under /run/vmd (the gateway routes the public ports to them), and
# takes the single-writer host lease before mutating any host state — so at most
# one generation is ever the writer. Type=notify: systemd reports the unit
# active only once vmd has finished startup and called sd_notify READY, not when
# the process forks. The handoff drives start/stop; generations are not enabled
# at boot, and a generation is never auto-restarted (Restart=no) so a crashed
# one does not race the next for the lease.

[Service]
Type=notify
NotifyAccess=main
# The generation id (%i) IS the release version, and each generation runs its
# own versioned binary. A rollback restarts the previous generation, which runs
# the previous binary — a genuine binary rollback, not a restart onto whatever
# was installed last. The deploy installs /usr/local/bin/vmd-<version> and
# retains the prior one so rollback has something to run.
ExecStart=/usr/local/bin/vmd-%i
Environment=VMD_GENERATION_ID=%i
Environment=VMD_PRIVATE_SOCKET=/run/vmd/gen-%i-grpc.sock
Environment=VMD_RESOLVER_SOCKET=/run/vmd/gen-%i-resolver.sock
Environment=VMD_GEN_CONTROL_SOCKET=/run/vmd/gen-%i-ctl.sock
EnvironmentFile=/etc/sandbox/vmd.env

# Signal only the main process, never the cgroup: VMs run under sandboxes.slice
# / superserve-vms.service and must survive a generation swap.
KillMode=process
Delegate=yes
# Auto-restart only on a CRASH (non-zero exit / signal), never on a clean stop —
# a deploy's `systemctl stop` exits 0 and must stay stopped. A crashed
# generation restarts into preflight (it does not auto-become writer); the
# gateway detects that and re-activates it, so a mid-life crash self-heals.
Restart=on-failure
RestartSec=2

# In-flight operations are drained by the handoff BEFORE stop, so a stop only
# flushes stores — it should complete in a few seconds. Force-kill quickly if it
# doesn't, so a stuck stop can't overrun the handoff's stop+activate budget; the
# kernel then releases the writer lease for the next generation.
TimeoutStopSec=10

LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vmd-%i
