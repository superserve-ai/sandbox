[Unit]
Description=Superserve secrets proxy
After=network-online.target
Wants=network-online.target
# Start before vmd so the unix socket exists when vmd dials it.
Before=superserve-vmd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/secretsproxy

KillMode=process
Restart=always
RestartSec=2

# Environment
EnvironmentFile=/etc/sandbox/secretsproxy.env

ProtectHome=yes
ProtectSystem=strict
NoNewPrivileges=yes
PrivateTmp=yes
RuntimeDirectory=secretsproxy
RuntimeDirectoryMode=0750
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=secretsproxy

[Install]
WantedBy=multi-user.target
