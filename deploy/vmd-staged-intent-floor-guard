#!/bin/sh
# Host-resident staged-intent floor for superserve-vmd, invoked from its own
# systemd drop-in at every service start. A guard of its own, not a line in
# the wake floor's: the revision that introduced that guard reinstalls it and
# its drop-in when it is deployed again, which is exactly what a rollback to
# that revision does, and a check added to that file would go with it. This
# file and drop-in are unknown to every earlier deploy script, so they stay.
#
# A capture of a running sandbox journals an intent saying the sandbox's own
# images were not rewritten. A vmd without the capability recovers that
# intent as an interrupted rewrite and strips the wall-clock manifest those
# images still need, so a later restore serves a frozen guest with no wake.
# The one witness is the evidence file, which the daemon writes, durably,
# before the first such intent on this host. Nothing here walks the snapshot
# trees; the witness has to be there before the intent is.
set -u
LC_ALL=C
export LC_ALL
BIN="${1:-/usr/local/bin/vmd}"
STAGED_EVIDENCE=/var/lib/sandbox/staged-intent-evidence

# One lookup. Only a lookup that says the file does not exist admits any vmd:
# no staged intent has ever been about to exist here. A lookup that fails any
# other way — an ancestor that cannot be traversed, a symlink loop — is not
# absence, and is treated as presence: only a binary that reads staged
# intents may start.
lookup=$(stat -L "$STAGED_EVIDENCE" 2>&1 >/dev/null)
if [ $? -ne 0 ]; then
    case "$lookup" in
        *"No such file or directory"*) exit 0 ;;
        *) echo "vmd-staged-intent-floor-guard: cannot look up ${STAGED_EVIDENCE} (${lookup}); only a vmd that reads staged intents may start" >&2 ;;
    esac
fi

# Evidence present, or unknowable: only a binary carrying the capability may
# start. One pass over the binary, bounded by its size; a grep that cannot
# run refuses.
if grep -qa staged-intent-1 "$BIN" 2>/dev/null; then
    exit 0
fi
echo "vmd-staged-intent-floor-guard: REFUSING to start a vmd without staged-intent-1: this host has journalled staged capture intents (${STAGED_EVIDENCE})" >&2
echo "vmd-staged-intent-floor-guard: deploy a build that reads them; the floor comes down only once no such intent can be recovered here" >&2
exit 1
