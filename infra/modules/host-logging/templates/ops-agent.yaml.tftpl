# Managed by Terraform/OS Config. The systemd_journald receiver is the only
# host-log source; the standalone OTel collector remains the application
# metrics path. The default file-based syslog pipeline is explicitly empty so
# each journal record has one steady-state collection path.
# The allowlist covers proxy.service and generation-specific proxy units.
%{ for unit in host_units ~}
# enrolled unit: ${unit}
%{ endfor ~}
# Ops Agent ${ops_agent_package_version} is selected by the OS policy. This
# release uses its documented built-in disk buffer cap (introduced in 2.28);
# no unsupported environment variable or generated Fluent Bit setting is used.
global:
  # The built-in self-log pipeline is disabled only to avoid duplicate file
  # ingestion; self-log ingestion remains enabled through the explicit,
  # bounded receiver below, which is the single producer for export failures.
  default_self_log_file_collection: false

logging:
  receivers:
    vmd_proxy_journald:
      # The supported 2.52 systemd_journald receiver has no unit/include
      # selector; allowlisting therefore remains an exclude_logs processor.
      # Reconciliation bounds the journald source and logging subagent with
      # persistent journal/free-space limits and a systemd CPU/memory quota.
      type: systemd_journald
    ops_agent_self_log_files:
      # The logging subagent writes supported flush/drop diagnostics here.
      # An explicit receiver gives the alert a stable log ID without adding a
      # second default pipeline for the same file.
      type: files
      include_paths:
        - /var/log/google-cloud-ops-agent/subagents/logging-module.log
  processors:
    # This is a provenance filter, not an application-data filter. The
    # _SYSTEMD_UNIT and _TRANSPORT fields are journal-managed and cannot be
    # selected by a client-controlled identifier field.
    exclude_non_platform_sources:
      type: exclude_logs
      match_any:
        - 'NOT (jsonPayload._SYSTEMD_UNIT =~ "^(superserve-vmd|proxy(-[^.]*)?|systemd(-[^.]*)?|google-osconfig-agent|google-guest-agent|google-cloud-ops-agent(-[^.]*)?|superserve-otel-collector|unbound|(superserve-)?secretsproxy|superserve-host-logging-heartbeat)\.service$" OR jsonPayload._TRANSPORT = "kernel")'
    capture_journal_provenance:
      type: modify_fields
      fields:
        labels.journal_unit:
          copy_from: jsonPayload._SYSTEMD_UNIT
        labels.journal_transport:
          copy_from: jsonPayload._TRANSPORT
        labels.journal_priority:
          copy_from: jsonPayload.PRIORITY
        labels.syslog_identifier:
          copy_from: jsonPayload.SYSLOG_IDENTIFIER
        labels.process_id:
          copy_from: jsonPayload._PID
    parse_application_json:
      type: parse_json
      # parse_json consumes the receiver's MESSAGE field; field is not a
      # supported parse_json option. The application timestamp uses strptime
      # syntax rather than a language-specific timestamp name.
      time_key: timestamp
      time_format: "%Y-%m-%dT%H:%M:%S.%L%Z"
    map_application_severity:
      type: modify_fields
      fields:
        severity:
          copy_from: jsonPayload.level
    map_legacy_application_severity:
      type: modify_fields
      fields:
        severity:
          copy_from: jsonPayload.severity
          # Cloud Logging filters use the documented :* presence operator.
          # The double-equals NULL form is rejected by the pinned Ops Agent
          # configuration validator.
          omit_if: 'NOT jsonPayload.severity:* OR severity:*'
    add_platform_context:
      type: modify_fields
      fields:
        labels.environment:
          static_value: ${environment}
        labels.region:
          static_value: ${region}
        labels.host_logging_assignment:
          static_value: ${assignment_name}
        labels.host_logging_revision:
          static_value: ${assignment_revision}
        labels.host_id:
          static_value: __HOST_ID__
        labels.incarnation:
          static_value: __INCARNATION_ID__
        labels.instance_id:
          copy_from: resource.labels.instance_id
        labels.unit:
          copy_from: labels.journal_unit
    redact_sensitive_fields:
      type: modify_fields
      fields:
        jsonPayload.authorization:
          omit_if: 'jsonPayload.authorization:*'
        jsonPayload.authorization_header:
          omit_if: 'jsonPayload.authorization_header:*'
        jsonPayload.cookie:
          omit_if: 'jsonPayload.cookie:*'
        jsonPayload.headers:
          omit_if: 'jsonPayload.headers:*'
        jsonPayload.password:
          omit_if: 'jsonPayload.password:*'
        jsonPayload.secret:
          omit_if: 'jsonPayload.secret:*'
        jsonPayload.token:
          omit_if: 'jsonPayload.token:*'
        jsonPayload.HOST_ID:
          omit_if: 'jsonPayload.HOST_ID:*'
        jsonPayload.host_id:
          omit_if: 'jsonPayload.host_id:*'
        jsonPayload.incarnation:
          omit_if: 'jsonPayload.incarnation:*'
        jsonPayload.request:
          omit_if: 'jsonPayload.request:*'
        jsonPayload.request_body:
          omit_if: 'jsonPayload.request_body:*'
        jsonPayload.file_contents:
          omit_if: 'jsonPayload.file_contents:*'
        jsonPayload.command_payload:
          omit_if: 'jsonPayload.command_payload:*'
        jsonPayload.body_snippet:
          omit_if: 'jsonPayload.body_snippet:*'
        jsonPayload.response_body:
          omit_if: 'jsonPayload.response_body:*'
        jsonPayload.response:
          omit_if: 'jsonPayload.response:*'
        jsonPayload.file:
          omit_if: 'jsonPayload.file:*'
        jsonPayload.file_path:
          omit_if: 'jsonPayload.file_path:*'
        jsonPayload.command:
          omit_if: 'jsonPayload.command:*'
        jsonPayload.payload:
          omit_if: 'jsonPayload.payload:*'
        jsonPayload.content:
          omit_if: 'jsonPayload.content:*'
        jsonPayload.data:
          omit_if: 'jsonPayload.data:*'
        jsonPayload.input:
          omit_if: 'jsonPayload.input:*'
        jsonPayload.output:
          omit_if: 'jsonPayload.output:*'
        jsonPayload.stdout:
          omit_if: 'jsonPayload.stdout:*'
        jsonPayload.stderr:
          omit_if: 'jsonPayload.stderr:*'
        jsonPayload.args:
          omit_if: 'jsonPayload.args:*'
        jsonPayload.argv:
          omit_if: 'jsonPayload.argv:*'
        jsonPayload.MESSAGE:
          # Parsing failures must not retain a raw application MESSAGE; it can
          # contain request, response, file, or command content. The positive
          # payload allowlist below also removes MESSAGE for host units.
          omit_if: 'jsonPayload.MESSAGE:* AND jsonPayload._SYSTEMD_UNIT =~ "^(superserve-vmd|proxy(-[^.]*)?)\.service$"'
    allowlisted_application_fields:
      # Parsed application JSON is not an export contract by itself: unknown
      # keys can contain credentials, request/file contents, or commands. Copy
      # only stable diagnostic/correlation keys to labels, then remove the
      # complete parsed payload below. Platform identity labels are populated
      # separately and cannot be supplied by application JSON.
      type: modify_fields
      fields:
        labels.request_id:
          copy_from: jsonPayload.request_id
        labels.sandbox_id:
          copy_from: jsonPayload.sandbox_id
        labels.proxy_generation:
          copy_from: jsonPayload.proxy_generation
        labels.proxy_revision:
          copy_from: jsonPayload.proxy_revision
        labels.service:
          copy_from: jsonPayload.service
        labels.component:
          copy_from: jsonPayload.component
        labels.event:
          copy_from: jsonPayload.event
        labels.error_code:
          copy_from: jsonPayload.error_code
        labels.status:
          copy_from: jsonPayload.status
        labels.host_logging_heartbeat:
          copy_from: jsonPayload.host_logging_heartbeat
    drop_unallowlisted_payload:
      # With no source, omit_if unsets the existing field. This is the
      # positive allowlist boundary: arbitrary parsed keys and raw MESSAGE
      # never reach Cloud Logging, including for secrets-proxy/systemd.
      type: modify_fields
      fields:
        jsonPayload:
          omit_if: 'jsonPayload:*'
    exclude_debug_after_parse:
      type: exclude_logs
      match_any:
        - 'severity = "DEBUG"'
        - 'severity = "TRACE"'
  service:
    pipelines:
      # Explicitly disable the built-in /var/log/syslog pipeline so a record
      # received from journald has exactly one steady-state collection path.
      default_pipeline:
        receivers: []
      host_logs:
        receivers:
          - vmd_proxy_journald
        processors:
          # Reject unrelated journal traffic before parsing JSON. Severity
          # filtering still happens after parsing for allowlisted sources.
          - exclude_non_platform_sources
          - capture_journal_provenance
          - parse_application_json
          - map_application_severity
          - map_legacy_application_severity
          - add_platform_context
          - redact_sensitive_fields
          - allowlisted_application_fields
          - drop_unallowlisted_payload
          - exclude_debug_after_parse
      ops_agent_self_logs:
        receivers:
          - ops_agent_self_log_files
metrics:
  receivers:
    hostmetrics:
      type: hostmetrics
      collection_interval: 60s
  service:
    pipelines:
      default_pipeline:
        receivers:
          - hostmetrics
        processors: []

# ${length(enrolled_hosts)} serving host descriptor(s) are Terraform inputs for
# rollout and IAM. The installed identity file is authoritative at runtime;
# application JSON cannot overwrite platform labels.
%{ for name, host in enrolled_hosts ~}
# ${name}: host_id=${host.host_id} incarnation=${host.incarnation} instance_id=${host.instance_id}
%{ endfor ~}
# The built-in checkpoint/retry path and disk buffer are used; no custom spool
# or per-entry namespace/mount is introduced. Reconciliation accounts for the
# buffer, self-log, and retained syslog stores independently of journald.
