# Managed by Terraform/OS Config. The supported Ops Agent systemd_journald
# receiver is the only log source; the standalone OTel collector remains the
# application-metrics path. No syslog-file receiver is configured, preventing
# duplicate ingestion of the same journal records.
# The processor allowlist includes proxy.service and generation-specific
# proxy-*.service units; kernel/systemd transport fields are retained for
# resource-exhaustion and lifecycle diagnostics.
%{ for unit in host_units ~}
# enrolled unit: ${unit}
%{ endfor ~}
# Tested package release selected by the rollout: ${ops_agent_package_version}.
logging:
  receivers:
    vmd_proxy_journald:
      type: systemd_journald
  processors:
    parse_application_json:
      type: parse_json
      field: jsonPayload.MESSAGE
      time_key: timestamp
      time_format: RFC3339Nano
    add_platform_context:
      type: modify_fields
      fields:
        labels.environment:
          static_value: ${environment}
        labels.region:
          static_value: ${region}
        labels.host_logging_assignment:
          static_value: ${assignment_name}
        labels.host_logging_revision:
          static_value: ${assignment_revision}
        labels.instance_id:
          copy_from: resource.labels.instance_id
        labels.host_id:
          copy_from: jsonPayload.HOST_ID
        labels.instance_name:
          copy_from: resource.labels.instance_name
        labels.unit:
          copy_from: jsonPayload._SYSTEMD_UNIT
        labels.proxy_generation:
          copy_from: jsonPayload.proxy_generation
        labels.incarnation:
          copy_from: jsonPayload.incarnation
    map_application_severity:
      type: modify_fields
      fields:
        severity:
          move_from: jsonPayload.severity
    exclude_non_platform_sources:
      type: exclude_logs
      match_any:
        - 'NOT (jsonPayload._SYSTEMD_UNIT =~ "^(superserve-vmd|proxy|proxy-generation|google-osconfig-agent|google-guest-agent|unbound|secretsproxy).*\\.service$" OR jsonPayload._TRANSPORT = "kernel" OR jsonPayload.SYSLOG_IDENTIFIER =~ "^(systemd|kernel|superserve-vmd|proxy)")'
    redact_sensitive_fields:
      type: modify_fields
      fields:
        jsonPayload.authorization:
          omit_if: 'jsonPayload.authorization != NULL'
        jsonPayload.request_body:
          omit_if: 'jsonPayload.request_body != NULL'
        jsonPayload.file_contents:
          omit_if: 'jsonPayload.file_contents != NULL'
        jsonPayload.command_payload:
          omit_if: 'jsonPayload.command_payload != NULL'
    exclude_debug_after_parse:
      type: exclude_logs
      match_any:
        - 'severity = "DEBUG"'
        - 'severity = "TRACE"'
  service:
    pipelines:
      # Explicitly disable the built-in /var/log/syslog pipeline so a record
      # received from journald has exactly one steady-state collection path.
      default_pipeline:
        receivers: []
      host_logs:
        receivers:
          - vmd_proxy_journald
        processors:
          - parse_application_json
          - exclude_non_platform_sources
          - map_application_severity
          - add_platform_context
          - redact_sensitive_fields
          - exclude_debug_after_parse
metrics:
  receivers:
    hostmetrics:
      type: hostmetrics
      collection_interval: 60s
  service:
    pipelines:
      default_pipeline:
        receivers:
          - hostmetrics
        processors: []

# ${length(enrolled_hosts)} serving host descriptor(s) are authoritative for
# identity mapping. Application JSON cannot overwrite these platform labels;
# request/sandbox correlation fields remain subordinate searchable fields.
%{ for name, host in enrolled_hosts ~}
# ${name}: host_id=${host.host_id} incarnation=${host.incarnation} instance_id=${host.instance_id}
%{ endfor ~}
# The built-in checkpoint/retry path and disk buffer are used; no custom spool
# or per-entry namespace/mount is introduced. Buffer sizing is verified during
# staging rollout and is independent of the 4 GiB journal budget.
