#!/usr/bin/env bash
set -euo pipefail

state_dir=/var/lib/superserve/host-logging
candidate='${candidate_config_path}'
service_candidate="$state_dir/otel-logs.service.candidate"
binary='${otel_binary_path}'
cursor='${cursor_dir}'
queue='${queue_dir}'

test -s "$candidate"
test -s "$service_candidate"
test -s /etc/sandbox/host-identity.json
grep -q '^receivers:' "$candidate"
grep -q '^  journald:' "$candidate"
grep -q 'storage: file_storage/cursor' "$candidate"
grep -q 'storage: file_storage/queue' "$candidate"
grep -q 'googlecloud:' "$candidate"
grep -q 'filter/info_plus:' "$candidate"
grep -q 'parse_application_message' "$candidate"
grep -q 'clear_untrusted_body' "$candidate"
grep -q 'host_logging.parse_outcome' "$candidate"
grep -q 'ProtectSystem=strict' "$service_candidate"

test "$(stat -c '%a' "$candidate" 2>/dev/null || stat -f '%Lp' "$candidate")" = "644"
test "$(stat -c '%a' "$service_candidate" 2>/dev/null || stat -f '%Lp' "$service_candidate")" = "644"

# The archive digest and release are checked by reconcile before activation;
# this check only validates an already installed candidate without changing it.
if [ -x "$binary" ]; then
  "$binary" --version 2>/dev/null | grep -F '${otel_release_version}' >/dev/null
fi

mkdir -p "$cursor" "$queue"
chmod 0700 "$cursor" "$queue"
test "${journal_max_use_bytes}" -gt 0
test "${journal_keep_free_bytes}" -gt 0
test "$(du -sb "$queue" | awk '{print $1}')" -le "${otel_queue_max_bytes}"
exit 0
