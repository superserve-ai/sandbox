#!/usr/bin/env bash
set -euo pipefail

state_dir='${state_dir}'
candidate='${candidate_config_path}'
service_candidate='${candidate_service_path}'
active_dir=/etc/superserve/host-logging
active_config="$active_dir/otel-logs.yaml"
active_service=/etc/systemd/system/superserve-otel-logs.service
heartbeat_service=/etc/systemd/system/superserve-host-logging-heartbeat.service
heartbeat_timer=/etc/systemd/system/superserve-host-logging-heartbeat.timer
queue_guard_service=/etc/systemd/system/superserve-host-logging-queue-guard.service
binary='${otel_binary_path}'
cursor='${cursor_dir}'
queue='${queue_dir}'
dropin=/etc/systemd/journald.conf.d/30-superserve-host-logging.conf
identity_file=/etc/sandbox/host-identity.json
identity_env=/etc/sandbox/host-logging-identity.env

# Every attempt owns one bounded staging directory. It is removed on success,
# pre-activation failure, activation failure, and interruption. No archive
# backup is retained indefinitely and no cursor/queue state is ever removed.
mkdir -p "$state_dir" /etc/systemd/journald.conf.d
chmod 0700 "$state_dir"
attempt=$(mktemp -d "$state_dir/.attempt.XXXXXX")
cleanup() { rm -rf -- "$attempt"; }
trap cleanup EXIT

test -s "$candidate" && test -s "$service_candidate"
test -s "$identity_file"
test -r "$candidate" && test -r "$service_candidate"

instance_id=$(sed -n 's/.*"instance_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$identity_file")
incarnation_id=$(sed -n 's/.*"incarnation_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$identity_file")
host_id=$(sed -n 's/.*"host_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$identity_file")
test -n "$instance_id" && test -n "$incarnation_id" && test -n "$host_id"

# Snapshot all mutable activation targets before any target is changed. A
# missing marker means this attempt owns creation and may remove only that file
# during rollback; unrelated pre-existing files are never guessed at.
snapshot() {
  local key="$1" target="$2"
  if [ -e "$target" ] || [ -L "$target" ]; then
    cp -a -- "$target" "$attempt/$key"
    printf 'present\n' > "$attempt/$key.present"
  else
    : > "$attempt/$key.absent"
  fi
}
restore_one() {
  local key="$1" target="$2"
  if [ -f "$attempt/$key.present" ]; then
    rm -f -- "$target"
    mkdir -p "$(dirname "$target")"
    cp -a -- "$attempt/$key" "$target"
  elif [ -f "$attempt/$key.absent" ]; then
    rm -f -- "$target"
  fi
}
snapshot config "$active_config"
snapshot service "$active_service"
snapshot dropin "$dropin"
snapshot binary "$binary"
snapshot identity_env "$identity_env"
snapshot heartbeat_service "$heartbeat_service"
snapshot heartbeat_timer "$heartbeat_timer"
snapshot queue_guard_service "$queue_guard_service"

service_was_active=0
timer_was_active=0
guard_was_active=0
systemctl is-active --quiet superserve-otel-logs.service 2>/dev/null && service_was_active=1 || true
systemctl is-active --quiet superserve-host-logging-heartbeat.timer 2>/dev/null && timer_was_active=1 || true
systemctl is-active --quiet superserve-host-logging-queue-guard.service 2>/dev/null && guard_was_active=1 || true

rollback() {
  local rc=$?
  [ "$${activation_committed:-0}" -eq 1 ] && { cleanup; exit "$rc"; }
  if [ "$${changed_binary:-0}" -eq 1 ]; then restore_one binary "$binary"; fi
  if [ "$${changed_config:-0}" -eq 1 ]; then restore_one config "$active_config"; fi
  if [ "$${changed_service:-0}" -eq 1 ]; then restore_one service "$active_service"; fi
  if [ "$${changed_dropin:-0}" -eq 1 ]; then restore_one dropin "$dropin"; fi
  if [ "$${changed_identity_env:-0}" -eq 1 ]; then restore_one identity_env "$identity_env"; fi
  if [ "$${changed_heartbeat_service:-0}" -eq 1 ]; then restore_one heartbeat_service "$heartbeat_service"; fi
  if [ "$${changed_heartbeat_timer:-0}" -eq 1 ]; then restore_one heartbeat_timer "$heartbeat_timer"; fi
  if [ "$${changed_queue_guard_service:-0}" -eq 1 ]; then restore_one queue_guard_service "$queue_guard_service"; fi
  systemctl daemon-reload >/dev/null 2>&1 || true
  if [ "$${activation_started:-0}" -eq 1 ] && [ "$service_was_active" -eq 1 ]; then
    systemctl restart superserve-otel-logs.service >/dev/null 2>&1 || true
  elif [ "$${activation_started:-0}" -eq 1 ]; then
    systemctl stop superserve-otel-logs.service >/dev/null 2>&1 || true
  fi
  if [ "$timer_was_active" -eq 1 ]; then
    systemctl start superserve-host-logging-heartbeat.timer >/dev/null 2>&1 || true
  else
    systemctl stop superserve-host-logging-heartbeat.timer >/dev/null 2>&1 || true
  fi
  if [ "$guard_was_active" -eq 1 ]; then
    systemctl start superserve-host-logging-queue-guard.service >/dev/null 2>&1 || true
  else
    systemctl stop superserve-host-logging-queue-guard.service >/dev/null 2>&1 || true
  fi
  cleanup
  exit "$rc"
}

# Trap is armed only after the complete pre-state has been recorded.
trap rollback EXIT INT TERM
activation_committed=0
changed_binary=0
changed_config=0
changed_service=0
changed_dropin=0
changed_identity_env=0
changed_heartbeat_service=0
changed_heartbeat_timer=0
changed_queue_guard_service=0
activation_started=0

# Admission is enforced by the bounded persistent exporter queue and the
# host filesystem free-space reserve; avoid an unbounded recursive queue scan
# in reconciliation.
free=$(df -Pk "$state_dir" 2>/dev/null | awk 'NR==2 {print $4 * 1024}')
queue_reserve=$(( ${journal_keep_free_bytes} + ${otel_queue_max_bytes} ))
test -n "$free" && test "$free" -ge "$queue_reserve"

# Validate the candidate with the exact release before changing active state.
stage="$attempt/stage"
mkdir -p "$stage"
staged_binary=''
if [ -x "$binary" ] && "$binary" --version 2>/dev/null | grep -F '${otel_release_version}' >/dev/null; then
  staged_binary="$binary"
else
  archive="$attempt/otelcol-contrib-${otel_release_version}.tar.gz"
  timeout '${package_operation_timeout_seconds}s' curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 '${otel_release_url}' -o "$archive"
  echo '${otel_release_sha256}  '"$archive" | sha256sum -c - >/dev/null
  tar -xzf "$archive" -C "$stage"
  staged_binary=$(find "$stage" -type f -name otelcol-contrib -perm -u+x -print -quit)
  test -n "$staged_binary"
fi
"$staged_binary" validate --config "$candidate"

cat > "$attempt/journald.conf" <<'EOF'
[Journal]
Storage=persistent
SystemMaxUse=${journal_max_use_bytes}B
SystemKeepFree=${journal_keep_free_bytes}B
EOF
cat > "$attempt/heartbeat.service" <<'EOF'
[Unit]
Description=Superserve host logging heartbeat

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'printf "{\\"host_logging_heartbeat\\":true,\\"heartbeat_epoch\\":%s}\\n" "$(date +%s)" | systemd-cat -t superserve-host-logging-heartbeat -p info'
EOF
cat > "$attempt/heartbeat.timer" <<'EOF'
[Unit]
Description=Superserve host logging heartbeat timer

[Timer]
OnBootSec=${heartbeat_interval_seconds}s
OnUnitActiveSec=${heartbeat_interval_seconds}s
Unit=superserve-host-logging-heartbeat.service

[Install]
WantedBy=timers.target
EOF
cat > "$attempt/queue-guard.service" <<EOF
[Unit]
Description=Bound Superserve OTel logs queue storage
After=superserve-otel-logs.service

[Service]
Type=simple
ExecStart=/bin/sh -c 'while :; do free=\$(df -Pk "${state_dir}" 2>/dev/null | awk "NR==2 {print \\$4 * 1024}"); reserve=$(( ${journal_keep_free_bytes} + ${otel_queue_max_bytes} )); if [ -z "\$free" ] || [ "\$free" -lt "\$reserve" ]; then logger -t superserve-otel-logs -p warning "queue_full free_bytes=\$${free:-0} reserve=\$reserve"; fi; sleep 15; done'
Restart=always
RestartSec=15s
CPUQuota=5%
MemoryMax=32M
Nice=19
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=${cursor_dir} ${queue_dir}

[Install]
WantedBy=multi-user.target
EOF
install -m 0644 "$attempt/journald.conf" "$attempt/dropin.new"
install -m 0644 "$attempt/heartbeat.service" "$attempt/heartbeat.service.new"
install -m 0644 "$attempt/heartbeat.timer" "$attempt/heartbeat.timer.new"
install -m 0644 "$attempt/queue-guard.service" "$attempt/queue-guard.service.new"
systemd-analyze verify "$attempt/queue-guard.service.new" >/dev/null 2>&1

printf 'HOST_ID=%s\nINSTANCE_ID=%s\nINCARNATION_ID=%s\n' "$host_id" "$instance_id" "$incarnation_id" > "$attempt/identity.env"
chmod 0600 "$attempt/identity.env"

mkdir -p "$cursor" "$queue"
chmod 0700 "$cursor" "$queue"
if [ "$staged_binary" != "$binary" ]; then
  install -D -m 0755 "$staged_binary" "$binary"
  changed_binary=1
fi
if ! cmp -s "$candidate" "$active_config" 2>/dev/null; then
  install -D -m 0644 "$candidate" "$active_config"
  changed_config=1
fi
if ! cmp -s "$service_candidate" "$active_service" 2>/dev/null; then
  install -D -m 0644 "$service_candidate" "$active_service"
  changed_service=1
fi
if ! cmp -s "$attempt/dropin.new" "$dropin" 2>/dev/null; then
  install -D -m 0644 "$attempt/dropin.new" "$dropin"
  changed_dropin=1
fi
if ! cmp -s "$attempt/identity.env" "$identity_env" 2>/dev/null; then
  install -D -m 0600 "$attempt/identity.env" "$identity_env"
  changed_identity_env=1
fi
if ! cmp -s "$attempt/heartbeat.service.new" "$heartbeat_service" 2>/dev/null; then
  install -D -m 0644 "$attempt/heartbeat.service.new" "$heartbeat_service"
  changed_heartbeat_service=1
fi
if ! cmp -s "$attempt/heartbeat.timer.new" "$heartbeat_timer" 2>/dev/null; then
  install -D -m 0644 "$attempt/heartbeat.timer.new" "$heartbeat_timer"
  changed_heartbeat_timer=1
fi
if ! cmp -s "$attempt/queue-guard.service.new" "$queue_guard_service" 2>/dev/null; then
  install -D -m 0644 "$attempt/queue-guard.service.new" "$queue_guard_service"
  changed_queue_guard_service=1
fi

systemctl daemon-reload
systemctl enable superserve-otel-logs.service >/dev/null
systemctl enable superserve-host-logging-heartbeat.timer >/dev/null
systemctl enable superserve-host-logging-queue-guard.service >/dev/null
if [ "$changed_binary" -eq 1 ] || [ "$changed_config" -eq 1 ] || [ "$changed_service" -eq 1 ] || [ "$service_was_active" -eq 0 ]; then
  activation_started=1
  systemctl restart superserve-otel-logs.service
fi
systemctl is-active --quiet superserve-otel-logs.service
systemctl enable --now superserve-host-logging-heartbeat.timer >/dev/null
systemctl enable --now superserve-host-logging-queue-guard.service >/dev/null
systemctl is-active --quiet superserve-host-logging-heartbeat.timer
systemctl is-active --quiet superserve-host-logging-queue-guard.service

# Verify active state after enforcement; a successful command is not enough.
cmp -s "$candidate" "$active_config"
cmp -s "$service_candidate" "$active_service"
"$binary" --version 2>/dev/null | grep -F '${otel_release_version}' >/dev/null
"$binary" validate --config "$active_config" >/dev/null
activation_committed=1
trap - EXIT INT TERM
rm -rf -- "$attempt"
exit 100
