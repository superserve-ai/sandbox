#!/usr/bin/env bash
set -euo pipefail

state_dir='${state_dir}'
candidate='${candidate_config_path}'
service_candidate='${candidate_service_path}'
active_dir=/etc/superserve/host-logging
active_config="$active_dir/otel-logs.yaml"
active_service=/etc/systemd/system/superserve-otel-logs.service
heartbeat_service=/etc/systemd/system/superserve-host-logging-heartbeat.service
heartbeat_timer=/etc/systemd/system/superserve-host-logging-heartbeat.timer
binary='${otel_binary_path}'
cursor='${cursor_dir}'
queue='${queue_dir}'
dropin='${journald_dropin}'
dropin_candidate='${journald_candidate_path}'
archive_dir="$state_dir/releases"
package_dir="$state_dir/package"
activation_committed=0
working_config=''
working_service=''
working_dropin=''
working_binary=''
working_heartbeat_service=''
working_heartbeat_timer=''
had_config=0
had_service=0
had_dropin=0
had_binary=0
had_heartbeat_service=0
had_heartbeat_timer=0
binary_changed=0
service_was_active=0

rollback() {
  [ "$activation_committed" -eq 1 ] && return 0
  if [ -n "$working_config" ] && [ -f "$working_config" ]; then install -m 0644 "$working_config" "$active_config"; fi
  if [ "$had_config" -eq 0 ]; then rm -f "$active_config"; fi
  if [ -n "$working_service" ] && [ -f "$working_service" ]; then install -m 0644 "$working_service" "$active_service"; fi
  if [ "$had_service" -eq 0 ]; then rm -f "$active_service"; fi
  if [ -n "$working_dropin" ] && [ -f "$working_dropin" ]; then install -m 0644 "$working_dropin" "$dropin"; fi
  if [ "$had_dropin" -eq 0 ]; then rm -f "$dropin"; fi
  if [ -n "$working_binary" ] && [ -f "$working_binary" ]; then install -m 0755 "$working_binary" "$binary"; fi
  if [ "$had_binary" -eq 0 ]; then rm -f "$binary"; fi
  if [ -n "$working_heartbeat_service" ] && [ -f "$working_heartbeat_service" ]; then install -m 0644 "$working_heartbeat_service" "$heartbeat_service"; fi
  if [ "$had_heartbeat_service" -eq 0 ]; then rm -f "$heartbeat_service"; fi
  if [ -n "$working_heartbeat_timer" ] && [ -f "$working_heartbeat_timer" ]; then install -m 0644 "$working_heartbeat_timer" "$heartbeat_timer"; fi
  if [ "$had_heartbeat_timer" -eq 0 ]; then rm -f "$heartbeat_timer"; fi
  systemctl daemon-reload >/dev/null 2>&1 || true
  if [ "$service_was_active" -eq 1 ]; then systemctl restart superserve-otel-logs.service >/dev/null 2>&1 || true; fi
}
trap rollback EXIT

mkdir -p "$state_dir" "$active_dir" "$archive_dir" "$cursor" "$queue" /etc/systemd/journald.conf.d
chmod 0700 "$cursor" "$queue"
test -s "$candidate" && test -s "$service_candidate"
test "$(du -sb "$queue" | awk '{print $1}')" -le '${otel_queue_max_bytes}'
systemctl is-active --quiet superserve-otel-logs.service && service_was_active=1 || true

# Identity is an input, never an output. A replacement host is not activated
# until the provisioner has installed its authoritative identity document.
identity_file=/etc/sandbox/host-identity.json
identity_env=/etc/sandbox/host-logging-identity.env
test -s "$identity_file" || { logger -t superserve-otel-logs -p warning "host identity is not provisioned; deferring activation"; exit 1; }
instance_id=$(sed -n 's/.*"instance_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$identity_file")
incarnation_id=$(sed -n 's/.*"incarnation_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$identity_file")
host_id=$(sed -n 's/.*"host_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$identity_file")
test -n "$instance_id" && test -n "$incarnation_id" && test -n "$host_id"
printf 'HOST_ID=%s\nINSTANCE_ID=%s\nINCARNATION_ID=%s\n' "$host_id" "$instance_id" "$incarnation_id" > "$identity_env.new"
install -m 0600 "$identity_env.new" "$identity_env"
rm -f "$identity_env.new"

if [ -f "$binary" ]; then cp -a "$binary" "$archive_dir/active-binary.$$.bak"; working_binary="$archive_dir/active-binary.$$.bak"; had_binary=1; fi
if [ -f "$heartbeat_service" ]; then cp -a "$heartbeat_service" "$archive_dir/active-heartbeat-service.$$.bak"; working_heartbeat_service="$archive_dir/active-heartbeat-service.$$.bak"; had_heartbeat_service=1; fi
if [ -f "$heartbeat_timer" ]; then cp -a "$heartbeat_timer" "$archive_dir/active-heartbeat-timer.$$.bak"; working_heartbeat_timer="$archive_dir/active-heartbeat-timer.$$.bak"; had_heartbeat_timer=1; fi

# Stage and verify the exact release before touching the active binary. The
# checksum is the release authority; no package manager or manual SSH path is
# used for activation.
if [ ! -x "$binary" ] || ! "$binary" --version 2>/dev/null | grep -F '${otel_release_version}' >/dev/null; then
  mkdir -p "$package_dir"
  archive="$package_dir/otelcol-contrib-${otel_release_version}.tar.gz"
  timeout '${package_operation_timeout_seconds}s' curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 '${otel_release_url}' -o "$archive"
  echo '${otel_release_sha256}  '"$archive" | sha256sum -c - >/dev/null
  stage="$package_dir/stage"
  rm -rf "$stage"
  mkdir -p "$stage"
  tar -xzf "$archive" -C "$stage"
  staged=$(find "$stage" -type f -name otelcol-contrib -perm -u+x -print -quit)
  test -n "$staged"
  install -D -m 0755 "$staged" "$binary.new"
  "$binary.new" validate --config "$candidate"
  install -D -m 0755 "$binary.new" "$binary"
  binary_changed=1
else
  "$binary" validate --config "$candidate"
fi

if [ -f "$active_config" ]; then cp -a "$active_config" "$archive_dir/active-config.$$.bak"; had_config=1; fi
if [ -f "$active_service" ]; then cp -a "$active_service" "$archive_dir/active-service.$$.bak"; had_service=1; fi
if [ -f "$dropin" ]; then cp -a "$dropin" "$archive_dir/active-journald.$$.bak"; had_dropin=1; fi
working_config="$archive_dir/active-config.$$.bak"
working_service="$archive_dir/active-service.$$.bak"
working_dropin="$archive_dir/active-journald.$$.bak"

cat > "$dropin_candidate" <<'EOF'
[Journal]
Storage=persistent
SystemMaxUse=${journal_max_use_bytes}B
SystemKeepFree=${journal_keep_free_bytes}B
EOF
install -m 0644 "$dropin_candidate" "$dropin.new"
systemd-analyze verify "$dropin.new" >/dev/null 2>&1 || true

cat > "$state_dir/heartbeat.service.candidate" <<'EOF'
[Unit]
Description=Superserve host logging heartbeat

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'printf "{\\"host_logging_heartbeat\\":true,\\"heartbeat_epoch\\":%s}\\n" "$(date +%s)" | systemd-cat -t superserve-host-logging-heartbeat -p info'
EOF
cat > "$state_dir/heartbeat.timer.candidate" <<'EOF'
[Unit]
Description=Superserve host logging heartbeat timer

[Timer]
OnBootSec=${heartbeat_interval_seconds}s
OnUnitActiveSec=${heartbeat_interval_seconds}s
Unit=superserve-host-logging-heartbeat.service

[Install]
WantedBy=timers.target
EOF
install -m 0644 "$state_dir/heartbeat.service.candidate" "$heartbeat_service.new"
install -m 0644 "$state_dir/heartbeat.timer.candidate" "$heartbeat_timer.new"

changed=0
cmp -s "$candidate" "$active_config" || changed=1
cmp -s "$service_candidate" "$active_service" || changed=1
cmp -s "$dropin.new" "$dropin" || changed=1
cmp -s "$state_dir/heartbeat.service.candidate" "$heartbeat_service" || changed=1
cmp -s "$state_dir/heartbeat.timer.candidate" "$heartbeat_timer" || changed=1
if [ "$changed" -eq 1 ] || [ "$binary_changed" -eq 1 ]; then
  install -m 0644 "$candidate" "$active_config.new"
  install -m 0644 "$service_candidate" "$active_service.new"
  install -m 0644 "$heartbeat_service.new" "$heartbeat_service"
  install -m 0644 "$heartbeat_timer.new" "$heartbeat_timer"
  install -m 0644 "$dropin.new" "$dropin"
  mv -f "$active_config.new" "$active_config"
  mv -f "$active_service.new" "$active_service"
  systemctl daemon-reload
  systemctl enable superserve-otel-logs.service >/dev/null
  systemctl restart superserve-otel-logs.service
  systemctl is-active --quiet superserve-otel-logs.service
fi

systemctl enable superserve-otel-logs.service >/dev/null
systemctl is-active --quiet superserve-otel-logs.service
systemctl daemon-reload
systemctl enable --now superserve-host-logging-heartbeat.timer >/dev/null
systemctl is-active --quiet superserve-host-logging-heartbeat.timer
activation_committed=1
rm -f "$archive_dir"/active-config.*.bak "$archive_dir"/active-service.*.bak "$archive_dir"/active-journald.*.bak "$archive_dir"/active-binary.*.bak "$archive_dir"/active-heartbeat-service.*.bak "$archive_dir"/active-heartbeat-timer.*.bak
exit 0
