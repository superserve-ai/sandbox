# Managed by Terraform/OS Config. OTel Contrib ${release_version}; logs state is separate from the
# existing metrics collector and from any legacy collector state.
extensions:
  file_storage/cursor:
    directory: ${cursor_dir}
    create_directory: true
  file_storage/queue:
    directory: ${queue_dir}
    create_directory: true
    compaction: true

receivers:
  journald:
    directory: /var/log/journal
    start_at: end
    storage: file_storage/cursor
    units:
%{ for unit in host_units ~}
      - ${unit}
%{ endfor ~}
    operators:
      # Journal fields are captured before MESSAGE is parsed. They are the
      # authoritative source for host provenance and source selection.
      - id: preserve_journal_metadata
        type: move
        from: attributes
        to: resource.attributes["journal.metadata"]
      - id: parse_application_message
        type: json_parser
        parse_from: body
        parse_to: attributes["application"]
        on_error: send
      - id: mark_parse_failure
        type: add
        field: attributes["host_logging.parse_outcome"]
        value: failure
        if: 'attributes["application"] == nil'
      - id: mark_export_failure
        type: add
        field: attributes["host_logging_export_error"]
        value: "true"
        if: 'resource.attributes["journal.metadata"]["_SYSTEMD_UNIT"] == "superserve-otel-logs.service" and IsMatch(body, "(?i)(export failed|permission denied|drop|dropped)")'
      - id: mark_parse_success
        type: add
        field: attributes["host_logging.parse_outcome"]
        value: success
        if: 'attributes["application"] != nil'
      - id: clear_untrusted_body
        type: move
        from: body
        to: attributes["host_logging.raw_body_discarded"]
      - id: set_trusted_unit
        type: copy
        from: resource.attributes["journal.metadata"]["_SYSTEMD_UNIT"]
        to: attributes["journal.unit"]
      - id: set_trusted_transport
        type: copy
        from: resource.attributes["journal.metadata"]["_TRANSPORT"]
        to: attributes["journal.transport"]

processors:
  filter/approved_sources:
    error_mode: ignore
    logs:
      log_record:
        - 'attributes["journal.unit"] != nil and not IsMatch(attributes["journal.unit"], "^(superserve-vmd|proxy(-[^.]*)?|systemd(-[^.]*)?|google-(osconfig|guest)-agent|superserve-otel-(collector|logs)|unbound|(superserve-)?secretsproxy|superserve-host-logging-heartbeat)\\.service$") and attributes["journal.transport"] != "kernel"'
  transform/trusted_payload:
    error_mode: ignore
    log_statements:
      - context: log
        statements:
          # The journald receiver's time is authoritative and is intentionally
          # left unchanged, preserving the original event timestamp.
          # Severity is parsed from application data before INFO+ filtering;
          # journal priority is not trusted for application DEBUG records.
          - set(severity_text, attributes["application"]["level"]) where attributes["application"]["level"] != nil
          - set(severity_text, attributes["application"]["severity"]) where severity_text == "" and attributes["application"]["severity"] != nil
          - set(severity_number, SEVERITY_NUMBER_DEBUG) where severity_text == "debug" or severity_text == "DEBUG"
          - set(severity_number, SEVERITY_NUMBER_INFO) where severity_text == "info" or severity_text == "INFO"
          - set(severity_number, SEVERITY_NUMBER_WARN) where severity_text == "warn" or severity_text == "warning" or severity_text == "WARN"
          - set(severity_number, SEVERITY_NUMBER_ERROR) where severity_text == "error" or severity_text == "ERROR"
          - set(severity_number, SEVERITY_NUMBER_FATAL) where severity_text == "fatal" or severity_text == "FATAL"
          - set(attributes["host_logging.parse_outcome"], "failure") where attributes["host_logging.parse_outcome"] == nil
          - set(resource.attributes["host_id"], "$${env:HOST_ID}")
          - set(resource.attributes["provider_instance_id"], "$${env:INSTANCE_ID}")
          - set(resource.attributes["incarnation"], "$${env:INCARNATION_ID}")
          - set(resource.attributes["environment"], "${environment}")
          - set(resource.attributes["region"], "${region}")
          - set(attributes["unit"], attributes["journal.unit"])
          - set(attributes["labels"], {}) where attributes["labels"] == nil
          - set(attributes["labels"]["journal_unit"], attributes["journal.unit"])
          - set(attributes["labels"]["host_logging_heartbeat"], true) where attributes["journal.unit"] == "superserve-host-logging-heartbeat.service"
          - set(attributes["generation"], attributes["journal.unit"]) where IsMatch(attributes["journal.unit"], "^proxy-")
          - set(attributes["request_id"], attributes["application"]["request_id"]) where attributes["application"]["request_id"] != nil
          - set(attributes["sandbox_id"], attributes["application"]["sandbox_id"]) where attributes["application"]["sandbox_id"] != nil
          - set(attributes["heartbeat"], true) where attributes["journal.unit"] == "superserve-host-logging-heartbeat.service"
          - delete_key(attributes["application"], "host_id")
          - delete_key(attributes["application"], "instance_id")
          - delete_key(attributes["application"], "incarnation")
          - delete_key(attributes["application"], "generation")
          - delete_key(attributes["application"], "labels")
          - delete_key(attributes["application"], "parse_outcome")
          - delete_key(attributes["application"], "httpRequest")
          - delete_key(attributes["application"], "trace")
          - delete_key(attributes["application"], "authorization")
          - set(body, attributes["application"]["event"]) where attributes["host_logging.parse_outcome"] == "success" and attributes["application"]["event"] != nil
          - delete_key(attributes, "application")
          - delete_key(attributes, "host_logging.raw_body_discarded")
  filter/info_plus:
    error_mode: ignore
    logs:
      log_record:
        - 'severity_number < SEVERITY_NUMBER_INFO'
  batch:
    timeout: 2s
    send_batch_size: 256

exporters:
  googlecloud:
    log:
      default_log_name: superserve_host_logs
    sending_queue:
      enabled: true
      storage: file_storage/queue
      # Record count bounds batching; the reconciliation/validation contract
      # separately enforces the Terraform queue byte budget.
      queue_size: 4096
      num_consumers: 2
    retry_on_failure:
      enabled: true
      initial_interval: 1s
      max_interval: 30s
      max_elapsed_time: 0s

service:
  extensions: [file_storage/cursor, file_storage/queue]
  pipelines:
    logs:
      receivers: [journald]
      processors: [filter/approved_sources, transform/trusted_payload, filter/info_plus, batch]
      exporters: [googlecloud]
  telemetry:
    logs:
      level: info
