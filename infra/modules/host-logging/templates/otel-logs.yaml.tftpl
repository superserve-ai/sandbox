# Managed by Terraform/OS Config. OTel Contrib ${release_version}; the logs
# process has independent cursor and queue state from the metrics collector.
extensions:
  file_storage/cursor:
    directory: ${cursor_dir}
    create_directory: true
  file_storage/queue:
    directory: ${queue_dir}
    create_directory: true
    compaction: true

receivers:
  journald:
    directory: /var/log/journal
    start_at: end
    storage: file_storage/cursor
    # Do not pass a glob here: journald unit selectors are exact names. The
    # approved_sources processor below performs prefix/regex selection so
    # dynamically generated proxy units are collected as well.
    operators:
      # Copy only bounded, trusted journal provenance. The receiver's complete
      # metadata map is never moved to a resource or sent to Cloud Logging.
      - id: copy_trusted_unit
        type: copy
        from: attributes["_SYSTEMD_UNIT"]
        to: attributes["journal.unit"]
      - id: copy_trusted_transport
        type: copy
        from: attributes["_TRANSPORT"]
        to: attributes["journal.transport"]
      - id: copy_trusted_hostname
        type: copy
        from: attributes["_HOSTNAME"]
        to: attributes["journal.hostname"]
      - id: copy_trusted_pid
        type: copy
        from: attributes["_PID"]
        to: attributes["journal.pid"]
      - id: copy_trusted_priority
        type: copy
        from: attributes["PRIORITY"]
        to: attributes["journal.priority"]
      - id: copy_trusted_boot
        type: copy
        from: attributes["_BOOT_ID"]
        to: attributes["journal.boot_id"]
      - id: copy_trusted_timestamp
        type: copy
        from: attributes["__REALTIME_TIMESTAMP"]
        to: attributes["journal.original_timestamp"]
      - id: classify_application_unit
        type: add
        field: attributes["host_logging.application_record"]
        value: true
        if: 'IsMatch(attributes["journal.unit"], "^(superserve-vmd|proxy(-[^.]*)?)\\.service$")'
      - id: preserve_message_for_parse
        type: copy
        from: body
        to: attributes["journal.original_message"]
      - id: parse_application_message
        type: json_parser
        parse_from: attributes["journal.original_message"]
        parse_to: attributes["application"]
        on_error: send
      - id: mark_parse_failure
        type: add
        field: attributes["host_logging.parse_outcome"]
        value: failure
        if: 'attributes["host_logging.application_record"] == true and attributes["application"] == nil'
      - id: mark_parse_success
        type: add
        field: attributes["host_logging.parse_outcome"]
        value: success
        if: 'attributes["host_logging.application_record"] == true and attributes["application"] != nil'
      - id: mark_export_failure
        type: add
        field: attributes["host_logging_export_error"]
        value: "true"
        if: 'attributes["journal.unit"] == "superserve-otel-logs.service" and IsMatch(attributes["journal.original_message"], "(?i)(export failed|permission denied|drop|dropped)")'
      # This named step is intentionally a move into a short-lived private
      # field. The transform processor below restores only approved diagnostic
      # text for non-application records and removes the field before export.
      - id: clear_untrusted_body
        type: move
        from: body
        to: attributes["host_logging.raw_body_discarded"]
      - id: retain_bounded_journal_fields
        type: retain
        fields:
          - body
          - attributes.journal.unit
          - attributes.journal.transport
          - attributes.journal.hostname
          - attributes.journal.pid
          - attributes.journal.boot_id
          - attributes.journal.original_timestamp
          - attributes.host_logging.application_record
          - attributes.host_logging.parse_outcome
          - attributes.host_logging.raw_body_discarded
          - attributes.host_logging_export_error
          - attributes.application

processors:
  filter/approved_sources:
    error_mode: ignore
    logs:
      log_record:
        - 'attributes["journal.unit"] != nil and not IsMatch(attributes["journal.unit"], "^(superserve-vmd|proxy(-[^.]*)?|systemd(-[^.]*)?|google-(osconfig|guest)-agent|superserve-otel-(collector|logs)|unbound|(superserve-)?secretsproxy|superserve-host-logging-heartbeat)\\.service$") and attributes["journal.transport"] != "kernel"'
  transform/trusted_payload:
    error_mode: ignore
    log_statements:
      - context: log
        statements:
          # Never restore an untrusted journal body. Host diagnostics are
          # represented by a bounded classification; application records are
          # reconstructed from approved scalar fields below.
          - set(body, "host diagnostic event") where attributes["host_logging.application_record"] != true
          - set(body, "application parse failure") where attributes["host_logging.parse_outcome"] == "failure"
          - set(body, "collector export failure") where attributes["host_logging_export_error"] == "true"
          - set(severity_text, attributes["application"]["level"]) where attributes["host_logging.application_record"] == true and IsString(attributes["application"]["level"])
          - set(severity_text, attributes["application"]["severity"]) where severity_text == "" and attributes["host_logging.application_record"] == true and IsString(attributes["application"]["severity"])
          - set(severity_number, SEVERITY_NUMBER_DEBUG) where severity_text == "debug" or severity_text == "DEBUG"
          - set(severity_number, SEVERITY_NUMBER_INFO) where severity_text == "info" or severity_text == "INFO"
          - set(severity_number, SEVERITY_NUMBER_WARN) where severity_text == "warn" or severity_text == "warning" or severity_text == "WARN"
          - set(severity_number, SEVERITY_NUMBER_ERROR) where severity_text == "error" or severity_text == "ERROR"
          - set(severity_number, SEVERITY_NUMBER_FATAL) where severity_text == "fatal" or severity_text == "FATAL"
          # Non-application diagnostics use trusted journald PRIORITY; this
          # keeps INFO+ host/kernel records while still shedding app DEBUG
          # whose journald priority is commonly mislabeled as INFO.
          - set(severity_number, SEVERITY_NUMBER_DEBUG) where attributes["host_logging.application_record"] != true and attributes["journal.priority"] == 7
          - set(severity_number, SEVERITY_NUMBER_INFO) where attributes["host_logging.application_record"] != true and (attributes["journal.priority"] == 5 or attributes["journal.priority"] == 6)
          - set(severity_number, SEVERITY_NUMBER_WARN) where attributes["host_logging.application_record"] != true and attributes["journal.priority"] == 4
          - set(severity_number, SEVERITY_NUMBER_ERROR) where attributes["host_logging.application_record"] != true and attributes["journal.priority"] == 3
          - set(severity_number, SEVERITY_NUMBER_FATAL) where attributes["host_logging.application_record"] != true and attributes["journal.priority"] <= 2
          - set(attributes["host_logging.parse_outcome"], "failure") where attributes["host_logging.application_record"] == true and attributes["host_logging.parse_outcome"] == nil
          - set(resource.attributes["host_id"], "$${env:HOST_ID}")
          - set(resource.attributes["provider_instance_id"], "$${env:INSTANCE_ID}")
          - set(resource.attributes["incarnation"], "$${env:INCARNATION_ID}")
          - set(resource.attributes["environment"], "${environment}")
          - set(resource.attributes["region"], "${region}")
          - set(attributes["unit"], attributes["journal.unit"])
          - set(attributes["source"], attributes["journal.transport"])
          - set(attributes["generation"], attributes["journal.unit"]) where IsMatch(attributes["journal.unit"], "^proxy-")
          - set(attributes["request_id"], attributes["application"]["request_id"]) where attributes["host_logging.parse_outcome"] == "success" and IsString(attributes["application"]["request_id"])
          - set(attributes["sandbox_id"], attributes["application"]["sandbox_id"]) where attributes["host_logging.parse_outcome"] == "success" and IsString(attributes["application"]["sandbox_id"])
          - set(attributes["event"], attributes["application"]["event"]) where attributes["host_logging.parse_outcome"] == "success" and IsString(attributes["application"]["event"])
          - set(attributes["message"], attributes["application"]["message"]) where attributes["host_logging.parse_outcome"] == "success" and IsString(attributes["application"]["message"])
          - set(body, attributes["event"]) where attributes["event"] != nil
          - set(body, attributes["message"]) where attributes["event"] == nil and attributes["message"] != nil
          # googlecloud maps scalar log attributes to Cloud Logging labels;
          # keep these names flat so consumers query the actual schema.
          - set(attributes["journal_unit"], attributes["journal.unit"])
          - set(attributes["host_logging_heartbeat"], true) where attributes["journal.unit"] == "superserve-host-logging-heartbeat.service"
          # This is a delivery-age sample relative to the retained journal
          # timestamp, not a heartbeat/absence signal. Cloud Monitoring uses
          # it only for the retained-history lag policy below.
          - set(attributes["host_logging_retained_history_lag_seconds"], (UnixNano(Now()) - time_unix_nano) / 1000000000) where time_unix_nano < UnixNano(Now())
          # Explicitly reject nested/special application keys and all raw
          # application maps. Only the scalar fields above cross the boundary.
          - delete_key(attributes["application"], "host_id")
          - delete_key(attributes["application"], "instance_id")
          - delete_key(attributes["application"], "incarnation")
          - delete_key(attributes["application"], "generation")
          - delete_key(attributes["application"], "labels")
          - delete_key(attributes["application"], "parse_outcome")
          - delete_key(attributes["application"], "httpRequest")
          - delete_key(attributes["application"], "trace")
          - delete_key(attributes["application"], "authorization")
          - delete_key(attributes, "application")
          - delete_key(attributes, "journal.original_message")
          - delete_key(attributes, "host_logging.raw_body_discarded")
          # Malformed application records have no body; trusted metadata and
          # the real failure marker remain. Valid records keep approved text.

  filter/info_plus:
    error_mode: ignore
    logs:
      log_record:
        - 'severity_number < SEVERITY_NUMBER_INFO'

exporters:
  googlecloud:
    log:
      default_log_name: superserve_host_logs
    sending_queue:
      enabled: true
      storage: file_storage/queue
      # queue_size bounds records. Physical storage is isolated and monitored
      # by the Terraform-managed guard without recursively scanning the queue
      # or stopping the only drainer.
      queue_size: 4096
      num_consumers: 2
    retry_on_failure:
      enabled: true
      initial_interval: 1s
      max_interval: 30s
      max_elapsed_time: 0s

service:
  extensions: [file_storage/cursor, file_storage/queue]
  pipelines:
    logs:
      receivers: [journald]
      # There is intentionally no asynchronous batch processor before the
      # persistent exporter queue. Receiver acceptance is handed directly to
      # the queue so a crash cannot strand an acknowledged batch in memory.
      processors: [filter/approved_sources, transform/trusted_payload, filter/info_plus]
      exporters: [googlecloud]
  telemetry:
    logs:
      level: info
