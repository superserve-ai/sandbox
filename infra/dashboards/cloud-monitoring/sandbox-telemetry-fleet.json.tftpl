{
  "displayName": "${display_name}",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Lifecycle Outcomes",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (operation, result) (rate(sandbox_transition_total{environment=\"${environment}\"}[30m]))"
                },
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "ops/sec",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Lifecycle p95 Latency",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95, sum by (le, operation) (rate(sandbox_transition_duration_seconds_bucket{environment=\"${environment}\"}[1h])))"
                },
                "plotType": "LINE",
                "targetAxis": "Y1"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "seconds",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Lifecycle Operation Rate",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (operation) (rate(sandbox_transition_total{environment=\"${environment}\"}[30m]))"
                },
                "plotType": "LINE",
                "targetAxis": "Y1"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "ops/sec",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Lifecycle Error Rate",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (operation, result) (rate(sandbox_transition_total{environment=\"${environment}\",result=~\"error|timeout|conflict\"}[30m]))"
                },
                "plotType": "LINE",
                "targetAxis": "Y1"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "errors/sec",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 8,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "Running or Transitioning Sandboxes",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum(host_capacity_running_sandboxes{environment=\"${environment}\"})"
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "fleet total"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "sandboxes",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 4,
        "yPos": 8,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "Fleet Used vCPU",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum(host_capacity_used_vcpu{environment=\"${environment}\"})"
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "fleet total"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "vCPU",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 8,
        "yPos": 8,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "Fleet Used Memory (MB)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum(host_capacity_used_memory_mib{environment=\"${environment}\"})"
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "fleet total"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "MiB",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 12,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Sandboxes by Host",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "max by (host_id) (host_capacity_running_sandboxes{environment=\"${environment}\"})"
                },
                "plotType": "LINE",
                "targetAxis": "Y1"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "sandboxes",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 12,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Lifecycle Success Ratio",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "(sum(rate(sandbox_transition_total{environment=\"${environment}\",result=\"success\"}[30m])) or vector(0)) / clamp_min(sum(rate(sandbox_transition_total{environment=\"${environment}\"}[30m])), 1e-9)"
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "success ratio"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "ratio",
              "scale": "LINEAR"
            }
          }
        }
      }
    ]
  }
}
